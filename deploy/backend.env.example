# Copy OUTSIDE Git and supply real values. This template is not deployable as-is.
APP_NAME=RChat
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://api.example.com
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rchat
DB_USERNAME=rchat
DB_PASSWORD=
SESSION_DRIVER=array
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_QUEUE_RETRY_AFTER=120
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=rchat
REVERB_APP_KEY=rchat-production
REVERB_APP_SECRET=
# Worker -> local Reverb HTTP API, protected by host/network boundaries.
# Public mobile socket is wss://ws.example.com:443, configured independently.
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=ws.example.com,api.example.com
FILESYSTEM_DISK=local
EXPO_ACCESS_TOKEN=
# Empty with direct nginx/FPM TLS termination; otherwise exact ingress IPs/CIDRs.
TRUSTED_PROXIES=
